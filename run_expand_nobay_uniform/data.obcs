 # Open-boundaries
 &OBCS_PARM01
 OB_Jsouth = 560*1,
 OB_Jnorth = 560*0,
 OB_Iwest = 352*1,
 OB_Ieast = 352*-1,
 useOrlanskiSouth=.TRUE.,
 useOrlanskiWest= .TRUE.,
 useOrlanskiEast= .TRUE.,
 useOBCSsponge=.TRUE.,
 useLinearSponge=.FALSE.,
 OBCSsponge_Salt=.FALSE.,
 OBCSsponge_Theta=.FALSE.,
 useOBCSbalance=.TRUE.,
 useOBCSprescribe=.FALSE.,
 OBCS_balanceFacS=-1.,
 OBCS_balanceFacW=1.,
 OBCS_balanceFacE=1.,
 OBCS_monitorFreq=1200.,
 &
 
 &OBCS_PARM02
# cvelTimeScale: averaging period for Orlanski phase speed (s).
#   Shortened 1000->250 so the estimate tracks the fast waves
#   (cell crossing time ~67 s at c=sqrt(gH)~75 m/s, dx=5 km).
# CMAX: max non-dimensional phase speed (CFL) allowed by Orlanski.
#   AB-II is stable only for CMAX<0.5 (orlanski_*.F); 1.0 was unstable.
 cvelTimeScale=250.0,
 CMAX=0.45,
 &


 &OBCS_PARM03
# Sponge (flow-relaxation) backs up the radiation. On the 5 km grid the
# barotropic mode has c*dt/dx~0.45 (right at the Orlanski/AB-II limit);
# the stretched margins (input/make_stretched_grid.py) drop it to ~0.17 so
# Orlanski radiates with margin, and this sponge absorbs the remainder.
 spongeThickness=30,
 Urelaxobcsinner=1200.E0,
 Vrelaxobcsinner=1200.E0,
 Urelaxobcsbound=60.E0,
 Vrelaxobcsbound=60.E0,
 &